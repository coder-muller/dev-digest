# Copie este arquivo para .env e preencha com os seus valores.
# O .env nunca vai para o Git (está no .gitignore).

# --- GitHub ---
# Seu usuário no GitHub
GITHUB_USERNAME=seu_usuario
# Fine-grained token, somente leitura (Settings > Developer settings > Personal access tokens)
GITHUB_TOKEN=seu_token_aqui
# Repositórios acompanhados: vazio = todos os seus; ou uma lista separada por vírgula (ex.: repo1,repo2)
GITHUB_REPOS=
# Também avisar sobre PRs de outras pessoas que pediram a sua revisão (true/false)
WATCH_REVIEW_REQUESTS=true

# --- IA (Vercel AI Gateway) ---
# Chave da API (Vercel > AI Gateway > API Keys)
AI_GATEWAY_API_KEY=sua_chave_aqui
# Modelo usado para escrever as mensagens (formato provedor/modelo)
AI_MODEL=google/gemini-2.5-flash

# --- Discord ---
# URL do webhook do canal (Editar canal > Integrações > Webhooks > Novo webhook > Copiar URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/seu_webhook_aqui

# --- Agendamento ---
# Horário do resumo matinal (HH:MM) e fuso horário
DIGEST_TIME=08:00
TIMEZONE=America/Sao_Paulo
# De quantos em quantos minutos verificar novidades
CHECK_INTERVAL_MINUTES=2
# Depois de quantos dias sem atividade uma PR é considerada parada
STALE_PR_DAYS=7
